# Copy to .env and run with `uv run --env-file .env uvicorn app.main:app --reload`
INVENTRA_DB_PATH=inventra.db
INVENTRA_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
INVENTRA_TOKEN_TTL_MINUTES=60
INVENTRA_CORS_ORIGINS=http://localhost:3000
INVENTRA_LOGIN_MAX_ATTEMPTS=5
INVENTRA_LOGIN_LOCKOUT_SECONDS=300
INVENTRA_LOGIN_MAX_ATTEMPTS_PER_CLIENT=20
# Behind a reverse proxy, run uvicorn with --forwarded-allow-ips=<proxy address> so the
# throttle sees real client addresses. Never use * unless the proxy strips X-Forwarded-For.
